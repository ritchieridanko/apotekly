{{ define "email_change_new" }}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>{{ .Subject }}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    style="
      margin: 0;
      padding: 32px 12px;
      background-color: #e7f0fa;
      font-family: 'Ubuntu', Arial, sans-serif;
    "
  >
    <!-- Card -->
    <div
      style="
        margin: 0 auto;
        padding: 32px 28px;
        width: 100%;
        max-width: 600px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(23, 23, 23, 0.06);
        border-radius: 6px;
      "
    >
      {{ template "header" . }}

      <p
        style="
          margin: 0 0 8px;
          color: #171717;
          font-size: 16px;
          font-weight: 400;
          line-height: 1.6;
        "
      >
        Hi <b style="color: #244da3">{{ .Recipient }}</b>,
      </p>
      <p
        style="
          margin: 0 0 24px;
          color: #171717;
          font-size: 16px;
          font-weight: 400;
          line-height: 1.6;
        "
      >
        We received a request to change the email address associated with your account. To start using your account with this email address, please confirm by clicking the button below. If you didn't request this change, you can safely ignore this email. Your account's current email address will remain unchanged until this confirmation is completed.
      </p>

      <!-- CTA -->
      <a
        href="{{ .URL }}"
        target="_blank"
        role="button"
        style="
          margin: 0 0 30px;
          padding: 10px 50px;
          display: inline-block;
          background-color: #244da3;
          box-shadow: 0 8px 24px rgba(23, 23, 23, 0.06);
          border-radius: 6px;
          color: #ffffff !important;
          font-family: inherit;
          font-size: 16px;
          font-weight: 500;
          line-height: 1.4;
          text-decoration: none;
        "
      >
        Confirm New Email Address
      </a>

      <!-- Divider -->
      <div style="height: 1px; background-color: #eeeeee; margin: 24px 0"></div>

      <!-- Fallback Link -->
      <p
        style="
          margin: 0 0 8px;
          color: #99a1af;
          font-size: 14px;
          line-height: 1.5;
        "
      >
        If the button above doesn't work, copy and paste this link into your browser:
      </p>
      <div
        style="
          margin-bottom: 30px;
          padding: 12px;
          background-color: #f3f4f6;
          border-radius: 6px;
          word-break: break-all;
        "
      >
        <a
          href="{{ .URL }}"
          target="_blank"
          style="
            color: #244da3;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
          "
        >
          {{ .URL }}
        </a>
      </div>
      
      {{ template "signature" . }}
    </div>

    {{ template "footer" . }}
  </body>
</html>
{{ end }}
