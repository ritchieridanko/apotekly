{{ define "email_change_old" }}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>{{ .Subject }}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    style="
      margin: 0;
      padding: 32px 12px;
      background-color: #e7f0fa;
      font-family: 'Ubuntu', Arial, sans-serif;
    "
  >
    <!-- Card -->
    <div
      style="
        margin: 0 auto;
        padding: 32px 28px;
        width: 100%;
        max-width: 600px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(23, 23, 23, 0.06);
        border-radius: 6px;
      "
    >
      {{ template "header" . }}

      <p
        style="
          margin: 0 0 8px;
          color: #171717;
          font-size: 16px;
          font-weight: 400;
          line-height: 1.6;
        "
      >
        Hi <b style="color: #244da3">{{ .Recipient }}</b>,
      </p>
      <p
        style="
          margin: 0 0 24px;
          color: #171717;
          font-size: 16px;
          font-weight: 400;
          line-height: 1.6;
        "
      >
        We received a request to change the email address associated with your account to <b>{{ .NewEmail }}</b>. No changes have been made yet. The new email address must first be confirmed. If you made this request, no further action needed. If you didn't request this change, please contact our support team immediately.
      </p>

      <!-- Divider -->
      <div style="height: 1px; background-color: #eeeeee; margin: 24px 0"></div>
      
      {{ template "signature" . }}
    </div>

    {{ template "footer" . }}
  </body>
</html>
{{ end }}
